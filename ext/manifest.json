{
  "manifest_version": 2,
  "name": "BySS",
  "version": "2.0.0",
  "description": "BySS: главная с погодой и конвертером валют, тема BySS, защита YouTube от рекламы и автоскролл.",
  "author": "BySS",
  "homepage_url": "https://github.com/andrewu1337-hub/BySS-PC",
  "browser_specific_settings": {
    "gecko": {
      "id": "byss@byss.app",
      "strict_min_version": "128.0",
      "update_url": "https://github.com/andrewu1337-hub/BySS-PC/releases/latest/download/updates.json"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "96": "icons/96.png",
    "128": "icons/128.png"
  },
  "background": {
    "scripts": [
      "shared/defaults.js",
      "background.js"
    ],
    "persistent": true
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "tabs",
    "theme",
    "browsingData",
    "downloads",
    "downloads.open",
    "<all_urls>"
  ],
  "chrome_url_overrides": {
    "newtab": "home/index.html"
  },
  "browser_action": {
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    },
    "default_title": "BySS",
    "default_popup": "popup/index.html",
    "default_area": "navbar"
  },
  "options_ui": {
    "page": "settings/index.html",
    "open_in_tab": true
  },
  "commands": {
    "autoscroll": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Автоскролл: запустить или остановить"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.youtube-nocookie.com/*"
      ],
      "js": [
        "yt/yt.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "yt/guard.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "autoscroll.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
